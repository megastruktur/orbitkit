#!/bin/sh
# Host pkgconf via its own loader (host shell sandbox can't exec /usr/bin directly).
HOST_ROOT="/usr"
run() {
  docker run --rm -i \
    -v /usr:/hu:ro \
    -e PKG_CONFIG_LIBDIR=/hu/lib64/pkgconfig:/hu/share/pkgconfig \
    -e PKG_CONFIG_SYSROOT_DIR=/hu \
    -e PKG_CONFIG_ALLOW_SYSTEM_LIBS=1 \
    -e PKG_CONFIG_ALLOW_SYSTEM_CFLAGS=1 \
    gcc:14 /hu/lib64/ld-linux-x86-64.so.2 --library-path /hu/lib64 /hu/bin/pkgconf --define-prefix "$@"
}
run "$@"
